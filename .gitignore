# Dependencies / build
node_modules/
dist/
build/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
# run.log is tracked state (per-cycle append) — keep it despite *.log
!run.log

# OS
.DS_Store
Thumbs.db

# Python venv (orchestrator toolchain)
.venv/
.venv
__pycache__/
*.pyc
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Orchestrator runtime artifacts (never tracked — the verifier writes these per cycle;
# committing a stale .verdict.yaml would let a later run read a leftover PASS verdict)
.verdict.yaml
.verdict.yml